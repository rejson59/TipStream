{
  "manifest_version": 3,
  "name": "GiftStream TikTok Browser Relay",
  "version": "1.0.0",
  "description": "Przekazuje widoczne zdarzenia LIVE z otwartej strony TikToka do lokalnego GiftStream.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "GiftStream Browser Relay",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
